{
  "expo": {
    "name": "GarageApp",
    "slug": "GarageApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cc.garageapp.app",
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDZRAKD5aPsUPXWMuTcUgt7E6B5TVv_NiI"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cc.garageapp.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA0HGKKiYyMx9CewrglXAjdDNhlaaEgttg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.garageapp",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a GarageApp acceder a tus fotos para actualizar tu perfil."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "ce126a0e-24ea-4a3c-9961-7688b173477a"
      }
    }
  }
}
